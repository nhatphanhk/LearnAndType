{
  "name": "learn-and-type",
  "productName": "LearnAndType",
  "version": "0.1.0",
  "description": "Học từ vựng tiếng Anh theo chủ đề thông qua luyện gõ",
  "main": "./out/main/index.js",
  "author": "nhatphanhk102",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:wordnet": "node scripts/build-wordnet-topics.mjs",
    "test:watch": "vitest",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "ts-fsrs": "5.4.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wordnet-db": "3.1.14"
  },
  "allowScripts": {
    "electron@45.3.3": true,
    "electron-winstaller": false
  }
}
